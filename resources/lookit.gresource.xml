<?xml version="1.0" encoding="UTF-8"?>
<!-- Lookit's icons, compiled into the binary. GTK's icon lookup wants the
     trailing .../scalable/apps/, so the prefix ends there and App passes only
     /io/github/scott8420/Lookit/icons to add_resource_path. The SVGs are made
     by tools/lookit_logo.py. (docs/resources-and-dialog-lifetime.md) -->
<gresources>
  <gresource prefix="/io/github/scott8420/Lookit/icons/scalable/apps">
    <file preprocess="xml-stripblanks" alias="io.github.scott8420.Lookit.svg">icons/scalable/apps/io.github.scott8420.Lookit.svg</file>
    <file preprocess="xml-stripblanks" alias="io.github.scott8420.Lookit-symbolic.svg">icons/scalable/apps/io.github.scott8420.Lookit-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="lookit-home-symbolic.svg">icons/scalable/apps/lookit-home-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="lookit-view-symbolic.svg">icons/scalable/apps/lookit-view-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="lookit-book-symbolic.svg">icons/scalable/apps/lookit-book-symbolic.svg</file>
  </gresource>
</gresources>
