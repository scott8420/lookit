[Desktop Entry]
Type=Application
Name=Lookit
GenericName=Document and Image Viewer
Comment=A quick look at PDFs and pictures
Exec=@EXEC@ %F
Icon=io.github.scott8420.Lookit
Terminal=false
Categories=Graphics;Viewer;Office;
StartupNotify=true
StartupWMClass=io.github.scott8420.Lookit
DBusActivatable=true
Keywords=pdf;image;picture;viewer;preview;photo;document;
MimeType=application/pdf;image/png;image/jpeg;image/gif;image/webp;image/tiff;image/bmp;image/svg+xml;image/heic;image/avif;
Actions=send-clipboard;

[Desktop Action send-clipboard]
Name=Open path on the clipboard
Exec=@EXEC@ --send-clipboard
